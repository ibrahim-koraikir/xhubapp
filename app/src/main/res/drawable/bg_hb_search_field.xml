<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle border for glass edge definition -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/appColorGlassFill" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>
    <!-- Inner fill -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/appColorCardSurface" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>
</layer-list>
