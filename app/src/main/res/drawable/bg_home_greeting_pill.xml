<?xml version="1.0" encoding="utf-8"?>
<!-- Greeting pill: glass fill + glass stroke, 30dp corner radius.
     Glass tokens invert (white-alpha on dark, black-alpha on light) so the pill
     stays visible across all themes. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/appColorGlassFill" />
    <stroke android:width="1dp" android:color="?attr/appColorGlassStroke" />
    <corners android:radius="@dimen/radius_full" />
</shape>
