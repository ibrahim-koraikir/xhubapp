<?xml version="1.0" encoding="utf-8"?>
<!-- Day-streak chip: 18% orange fill, 35% orange stroke, 20dp corner radius.
     NOTE: fill/stroke use solid appColorAccentOrange — decorative alpha variants
     (18%/35%) are kept as theme-resolved solid for now; alpha is baked into the
     gradient look via the chip's own tint. Tuned per-theme via the orange token. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/appColorAccentOrange" />
    <stroke android:width="1dp" android:color="?attr/appColorAccentOrange" />
    <corners android:radius="@dimen/radius_full" />
</shape>
