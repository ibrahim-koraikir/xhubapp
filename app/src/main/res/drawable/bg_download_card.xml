<?xml version="1.0" encoding="utf-8"?>
<!-- Glass-aligned download card — matches home tile/card language -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/appColorCardSurface" />
    <stroke
        android:width="1dp"
        android:color="?attr/appColorGlassStroke" />
    <corners android:radius="@dimen/home_card_radius" />
</shape>
