<?xml version="1.0" encoding="utf-8"?>
<!-- Circular flame button: orange gradient fill (light → dark). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="linear"
        android:startColor="?attr/appColorAccentOrangeLight"
        android:endColor="?attr/appColorAccentOrangeDark"
        android:angle="45" />
</shape>
