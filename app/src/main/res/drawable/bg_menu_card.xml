<?xml version="1.0" encoding="utf-8"?>
<!-- Premium settings menu card: richer dark with gradient-glow top edge -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Gradient top-edge glow line -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#33FF007A"
                android:centerColor="#221A1C1E"
                android:endColor="#001A1C1E"
                android:angle="90" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <!-- Solid border ring -->
    <item
        android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurface" />
            <stroke android:width="1dp" android:color="#25FFFFFF" />
            <corners android:radius="17dp" />
        </shape>
    </item>
</layer-list>
