<?xml version="1.0" encoding="utf-8"?>
<!-- Premium linear gradient scrim for dark theme.
     Fades from transparent at the top to solid dark near the bottom
     so that the starfield shines brightly at the top while content at the bottom remains readable. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:startColor="#00121212"
        android:centerColor="#80121212"
        android:endColor="#FF121212"
        android:angle="270" />
</shape>
