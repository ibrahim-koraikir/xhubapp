<?xml version="1.0" encoding="utf-8"?>
<!-- White squircle background for shortcut tiles — applied when a favicon loads so that
     transparent PNG favicons remain visible against a light backdrop. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/white" />
    <stroke
        android:width="@dimen/home_tile_stroke_width"
        android:color="@color/home_tile_stroke" />
    <corners android:radius="@dimen/home_tile_radius" />
</shape>
