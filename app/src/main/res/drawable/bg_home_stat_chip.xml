<?xml version="1.0" encoding="utf-8"?>
<!-- Stat chip: glass fill + glass stroke, 20dp corner radius. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/appColorGlassFill" />
    <stroke android:width="1dp" android:color="?attr/appColorGlassStroke" />
    <corners android:radius="@dimen/radius_full" />
</shape>
