<?xml version="1.0" encoding="utf-8"?>
<!-- Active tab card: gradient glow border (pink → violet) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Gradient glow outer ring -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FF007A"
                android:endColor="#9C00FF"
                android:angle="135" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Inner card backdrop - inset by stroke width -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/tab_grid_card" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
