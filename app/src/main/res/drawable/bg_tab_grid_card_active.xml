<?xml version="1.0" encoding="utf-8"?>
<!-- Active tab card: gradient glow border (pink → violet) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Gradient glow outer ring -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="?attr/colorPrimary"
                android:endColor="?attr/appColorAccentPurple2"
                android:angle="135" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>
    <!-- Inner card backdrop - inset by stroke width -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/appColorCardSurface" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>
</layer-list>
