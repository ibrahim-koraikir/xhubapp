<?xml version="1.0" encoding="utf-8"?>
<!--
  History/Bookmark List Item
  Redesigned using:
    - impeccable: NO hairline dividers (banned side-stripe borders); spacing rhythm instead
    - taste-skill: Icon circle uses brand accent tint at 18%, not flat grey
    - Emil Kowalski: stateListAnimator for tactile press scale 0.97
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:stateListAnimator="@animator/press_scale">

    <LinearLayout
        android:id="@+id/item_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- Icon circle — pink-tinted accent, matches app brand -->
        <FrameLayout
            android:id="@+id/icon_container"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_hb_icon_circle">

            <ImageView
                android:id="@+id/item_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                app:tint="?attr/colorPrimary"
                tools:src="@drawable/ic_privacy_shield" />

            <!-- Letter fallback for favicon (e.g. "G" for Google) -->
            <TextView
                android:id="@+id/item_icon_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="G"
                android:textColor="@color/app_google_blue"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Title + URL column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/item_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorOnBackground"
                android:textSize="15sp"
                android:letterSpacing="0.005"
                tools:text="Website Title" />

            <TextView
                android:id="@+id/item_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/appColorMutedForeground"
                android:textSize="12sp"
                tools:text="www.example.com" />
        </LinearLayout>

        <!-- Timestamp — right-aligned, muted -->
        <TextView
            android:id="@+id/item_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="?attr/appColorMutedForeground"
            android:textSize="12sp"
            tools:text="7:42 PM" />
    </LinearLayout>

    <!--
      impeccable: NO hairline dividers.
      Visual separation is achieved by spacing (paddingTop/Bottom 12dp) alone.
      The item_divider view is kept invisible for any code that references it by ID.
    -->
    <View
        android:id="@+id/item_divider"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>
