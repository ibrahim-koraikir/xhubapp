<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Comet-style dark pill tab item for horizontal desktop tab bar -->
    <LinearLayout
        android:id="@+id/tab_item_background"
        android:layout_width="@dimen/desktop_tab_width"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="2dp"
        android:layout_marginVertical="2dp"
        android:background="@drawable/tab_item_bg"
        android:clickable="true"
        android:focusable="true"
        android:checkable="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="6dp">

        <!-- Favicon -->
        <com.xhub.browser.view.ImageView
            android:id="@+id/faviconTab"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="5dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <!-- Tab title -->
        <TextView
            android:id="@+id/textTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="?attr/colorOnBackground"
            android:textSize="11sp" />

        <!-- Close button -->
        <FrameLayout
            android:id="@+id/deleteAction"
            android:layout_width="22dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:background="?attr/actionBarItemBackground"
            android:gravity="center">

            <com.xhub.browser.view.ImageView
                android:id="@+id/deleteButton"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_gravity="center"
                android:contentDescription="@string/close_tab"
                android:alpha="0.6"
                app:srcCompat="@drawable/ic_action_delete" />
        </FrameLayout>
    </LinearLayout>

</layout>