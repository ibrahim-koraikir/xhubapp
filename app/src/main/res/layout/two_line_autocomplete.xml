<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <com.xhub.browser.view.ImageView
        android:id="@+id/suggestionIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:scaleType="centerInside"
        android:contentDescription="@null"
        app:tint="#B0B0CC" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/url"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#9090AB"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <com.xhub.browser.view.ImageView
        android:id="@+id/complete_search"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:padding="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/search_insert_suggestion"
        android:scaleType="centerInside"
        app:srcCompat="@drawable/ic_insert"
        app:tint="#70708C" />

</LinearLayout>
