<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_search_overlay"
    android:paddingTop="12dp">

    <!-- Handle -->
    <View
        android:id="@+id/drag_handle"
        android:layout_width="48dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_handle"
        android:alpha="0.5" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Suggestions"
        android:textColor="?attr/appColorSubtleForeground"
        android:textSize="14sp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/suggestions_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

    <!-- Bottom Search Bar with Cyan Gradient Border -->
    <LinearLayout
        android:id="@+id/bottom_search_bar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        android:paddingTop="8dp">

        <LinearLayout
            android:id="@+id/search_bar_ask"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_ask_search_bar"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <EditText
                android:id="@+id/search_input_ask"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Ask anything..."
                android:textColor="?attr/colorOnBackground"
                android:textColorHint="#666666"
                android:textSize="16sp"
                android:singleLine="true"
                android:imeOptions="actionGo"
                android:inputType="textUri" />

            <ImageButton
                android:id="@+id/submit_btn_ask"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/control_circle_primary_bg"
                android:src="@drawable/ic_action_forward"
                app:tint="@color/black" />

        </LinearLayout>
    </LinearLayout>

</LinearLayout>
