<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone"
    tools:visibility="visible">

    <!-- Full-screen Starfield Background Image (theme-aware via ?attr/appHomeBackground) -->
    <ImageView
        android:id="@+id/homeScreenBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="?attr/appHomeBackground"
        android:contentDescription="@null"
        android:importantForAccessibility="no" />

    <!-- Scrim overlay — theme-aware (?attr/appStarfieldScrim: dark on dark themes, faint on light) -->
    <View
        android:id="@+id/homeScreenBackgroundOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/appStarfieldScrim"
        android:importantForAccessibility="no" />

    <!-- Scrollable body (hero header now scrolls with the page) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?attr/appHomeHeroBackground"
            android:paddingHorizontal="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="@dimen/home_padding_bottom">

            <!-- ── HERO HEADER (static quote / streak / stats) ─────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/home_hero_padding_top"
                android:paddingHorizontal="@dimen/home_hero_padding_h"
                android:paddingBottom="@dimen/home_hero_padding_bottom">

                <!-- ── Action row: settings (left) · streak chip + flame button (right) ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Settings (glass circle) -->
                    <FrameLayout
                        android:layout_width="@dimen/home_hero_action_btn"
                        android:layout_height="@dimen/home_hero_action_btn"
                        android:background="@drawable/bg_home_action_glass">

                        <ImageButton
                            android:id="@+id/homeSettingsBtn"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_settings"
                            android:padding="10dp"
                            android:scaleType="fitCenter"
                            app:tint="?attr/colorOnBackground"
                            android:contentDescription="@string/home_settings_desc" />
                    </FrameLayout>

                    <!-- Spacer pushes the right group to the end -->
                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <!-- Streak chip + flame button -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Day streak chip -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_home_streak_chip"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="6dp"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="@string/home_streak_desc">

                            <ImageView
                                android:layout_width="@dimen/home_hero_streak_icon"
                                android:layout_height="@dimen/home_hero_streak_icon"
                                android:src="@drawable/ic_zap"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                app:tint="?attr/appColorAccentOrangeLight" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_xs"
                                android:text="@string/home_streak_count"
                                android:textColor="?attr/appColorAccentOrangeLight"
                                android:textAppearance="@style/TextAppearance.App.BodyMedium"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_xs"
                                android:text="@string/home_streak_label"
                                android:textColor="?attr/appColorAccentOrangeLight"
                                android:textAppearance="@style/TextAppearance.App.BodySmall" />
                        </LinearLayout>

                        <!-- Flame (bookmarks) button -->
                        <FrameLayout
                            android:id="@+id/homeBookmarksButton"
                            android:layout_width="@dimen/home_hero_action_btn"
                            android:layout_height="@dimen/home_hero_action_btn"
                            android:background="@drawable/bg_home_flame_btn"
                            android:elevation="6dp">

                            <ImageView
                                android:layout_width="@dimen/home_hero_flame_icon"
                                android:layout_height="@dimen/home_hero_flame_icon"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_flame"
                                android:contentDescription="@string/home_flame_desc"
                                app:tint="?attr/colorOnBackground" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- ── Greeting pill ────────────────────────────────────── -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_home_greeting_pill"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="22dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👋"
                        android:textAppearance="@style/TextAppearance.App.BodyMedium" />

                    <TextView
                        android:id="@+id/homeGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:text="@string/home_greeting_morning"
                        android:textColor="?attr/appColorMutedForeground"
                        android:textAppearance="@style/TextAppearance.App.GreetingLabel" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:text="@string/home_user_name"
                        android:textColor="?attr/appColorAccentOrangeLight"
                        android:textAppearance="@style/TextAppearance.App.GreetingLabel"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- ── Quote mark ───────────────────────────────────────── -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="❝"
                    android:textColor="?attr/appColorAccentOrangeFaint"
                    android:textAppearance="@style/TextAppearance.App.QuoteMark"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:layout_gravity="center_horizontal" />

                <!-- ── Quote text (homeTitle id — required by HomeScreenLayoutTest) ── -->
                <TextView
                    android:id="@+id/homeTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_quote_text"
                    android:textColor="?attr/colorOnBackground"
                    android:textAppearance="@style/TextAppearance.App.DisplayMedium"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:letterSpacing="0.01"
                    android:layout_marginTop="-12dp"
                    android:layout_marginHorizontal="@dimen/spacing_xs" />

                <!-- ── Divider + "Quote of the day" label ───────────────── -->
                <View
                    android:layout_width="@dimen/spacing_xl"
                    android:layout_height="@dimen/elevation_sm"
                    android:background="@drawable/bg_home_quote_divider"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/spacing_lg" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_quote_label"
                    android:textColor="?attr/appColorAccentOrange"
                    android:textAppearance="@style/TextAppearance.App.LabelMedium"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/spacing_sm" />

                <!-- ── Stat chips: saved · downloads · Private ──────────── -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/spacing_xl">

                    <!-- Saved -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_home_stat_chip"
                        android:paddingHorizontal="@dimen/spacing_md"
                        android:paddingVertical="7dp"
                        android:layout_marginEnd="@dimen/spacing_sm">

                        <ImageView
                            android:layout_width="@dimen/home_stat_icon"
                            android:layout_height="@dimen/home_stat_icon"
                            android:src="@drawable/ic_bookmark"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            app:tint="?attr/appColorDimForeground" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_xs"
                            android:text="@string/home_stat_saved"
                            android:textColor="?attr/appColorDimForeground"
                            android:textAppearance="@style/TextAppearance.App.LabelSmall" />
                    </LinearLayout>

                    <!-- Downloads -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_home_stat_chip"
                        android:paddingHorizontal="@dimen/spacing_md"
                        android:paddingVertical="7dp"
                        android:layout_marginEnd="@dimen/spacing_sm">

                        <ImageView
                            android:layout_width="@dimen/home_stat_icon"
                            android:layout_height="@dimen/home_stat_icon"
                            android:src="@drawable/ic_download"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            app:tint="?attr/appColorDimForeground" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_xs"
                            android:text="@string/home_stat_downloads"
                            android:textColor="?attr/appColorDimForeground"
                            android:textAppearance="@style/TextAppearance.App.LabelSmall" />
                    </LinearLayout>

                    <!-- Private -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_home_stat_chip"
                        android:paddingHorizontal="@dimen/spacing_md"
                        android:paddingVertical="7dp">

                        <ImageView
                            android:layout_width="@dimen/home_stat_icon"
                            android:layout_height="@dimen/home_stat_icon"
                            android:src="@drawable/ic_shield"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            app:tint="?attr/appColorAccentPurple" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_xs"
                            android:text="@string/home_stat_private"
                            android:textColor="?attr/appColorDimForeground"
                            android:textAppearance="@style/TextAppearance.App.LabelSmall" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- ── SHORTCUTS SECTION (preserved — internal contents unchanged) ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_home_shortcut_card"
                android:padding="@dimen/home_card_padding"
                android:layout_marginHorizontal="@dimen/home_padding_horizontal"
                android:layout_marginTop="@dimen/home_padding_top">

                <!-- Section header row -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/home_section_header_min_height"
                    android:layout_marginBottom="@dimen/home_section_header_margin_bottom">

                    <TextView
                        android:id="@+id/shortcutsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/home_quick_access_title"
                        android:textColor="?attr/colorOnBackground"
                        android:textAppearance="@style/TextAppearance.App.TitleLarge"
                        android:letterSpacing="0.01"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/btnEditShortcuts"
                        app:layout_constraintBottom_toTopOf="@+id/shortcutsSubtitle" />

                    <TextView
                        android:id="@+id/shortcutsSubtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/home_quick_access_subtitle"
                        android:textColor="?attr/appColorSubtleForeground"
                        android:textAppearance="@style/TextAppearance.App.BodySmall"
                        app:layout_constraintTop_toBottomOf="@+id/shortcutsTitle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/btnEditShortcuts"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <!-- Edit button with ripple feedback -->
                    <LinearLayout
                        android:id="@+id/btnEditShortcuts"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/home_edit_btn_height"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/home_edit_btn_padding_h"
                        android:background="@drawable/bg_shortcut_manager_icon_btn"
                        android:foreground="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@string/home_edit_shortcuts_desc"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <ImageView
                            android:layout_width="@dimen/home_edit_icon_size"
                            android:layout_height="@dimen/home_edit_icon_size"
                            android:src="@drawable/ic_edit_outline"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:tint="?attr/appColorDimForeground" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/home_edit_icon_label_gap"
                            android:text="@string/home_edit_shortcuts"
                            android:textColor="?attr/appColorDimForeground"
                            android:textAppearance="@style/TextAppearance.App.BodyMedium" />

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Dynamic shortcut tile grid.
                     COMMENT 6: was a LinearLayout rebuilt programmatically on every home visit;
                     now a RecyclerView so tiles are recycled and only changed items are rebound. -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/shortcutsDynamicContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
