<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardDownload"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    app:cardBackgroundColor="?attr/appColorCardSurface"
    app:cardCornerRadius="@dimen/home_card_radius"
    app:cardElevation="0dp"
    app:strokeColor="?attr/appColorGlassStroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="88dp"
        android:orientation="horizontal">

        <!-- Active download accent -->
        <View
            android:id="@+id/viewActiveAccent"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="?attr/appColorAccentOrange"
            android:visibility="gone" />

        <!-- Thumbnail / icon -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="88dp"
            android:layout_height="68dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="?attr/appColorGlassFill"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/imgThumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <FrameLayout
                    android:id="@+id/containerFileIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/appColorGlassFill">

                    <ImageView
                        android:id="@+id/imgFileIcon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_download_outline"
                        android:tint="?attr/appColorAccentOrange" />
                </FrameLayout>

                <ImageView
                    android:id="@+id/imgPlayOverlay"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:alpha="0.95"
                    android:src="@drawable/ic_play_arrow"
                    android:tint="@android:color/white"
                    android:visibility="gone" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Text -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/tvDownloadTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="video_1080p.mp4" />

            <TextView
                android:id="@+id/tvDownloadMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="?attr/appColorMutedForeground"
                android:textSize="12sp"
                tools:text="24 MB · Today 3:12 PM" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_status_pill"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Complete" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressDownload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:indicatorColor="?attr/appColorAccentOrange"
                app:trackColor="?attr/appColorGlassFill"
                app:trackCornerRadius="4dp"
                app:trackThickness="4dp" />
        </LinearLayout>

        <!-- Actions -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnPauseResumeDownload"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_download_icon_btn"
                android:contentDescription="@string/pause_download"
                android:padding="8dp"
                android:src="@drawable/ic_pause"
                android:tint="?attr/colorOnSurface"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnCancelDownload"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_download_icon_btn"
                android:contentDescription="@string/cancel_download"
                android:padding="8dp"
                android:src="@drawable/ic_action_delete"
                android:tint="?attr/colorOnSurface"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnDownloadOptions"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_download_icon_btn"
                android:contentDescription="@string/more_options"
                android:padding="8dp"
                android:src="@drawable/ic_more_vertical"
                android:tint="?attr/appColorMutedForeground" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
