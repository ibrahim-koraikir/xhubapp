<?xml version="1.0" encoding="utf-8"?>
<!--
    Google Mobile Services (GMS) font provider certificate hashes.
    Required by Android's downloadable-fonts API to verify the font provider identity.
    Crucial: Base64 strings must be a single line with no newlines or spaces,
    otherwise android.util.Base64.decode will throw "bad base-64" on some Android versions.
-->
<resources>
    <array name="com_google_android_gms_fonts_certs">
        <item>@array/com_google_android_gms_fonts_certs_dev</item>
        <item>@array/com_google_android_gms_fonts_certs_prod</item>
    </array>

    <!-- Development certificate (used during development builds) -->
    <string-array name="com_google_android_gms_fonts_certs_dev">
        <item></item>
    </string-array>

    <!-- Production certificate (used in release builds / Play Store) -->
    <string-array name="com_google_android_gms_fonts_certs_prod">
        <item></item>
    </string-array>
</resources>
