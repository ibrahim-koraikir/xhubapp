<?xml version="1.0" encoding="utf-8"?>
<!--
 Single source of truth for home-screen token HEX VALUES. Concrete hex lives only here;
 theme styles (styles.xml) reference these by name, and layouts/drawables reference them
 indirectly via ?attr/appColor*. Using @color/ references (rather than raw hex in styles)
 is required for Robolectric SDK-27 theme-attr resolution to work in unit tests.

 Naming: home_token_<role>_<theme>  — where <theme> ∈ {light, white, dark, black}.
 White usually aliases Light values except where noted.
-->
<resources>

    <!-- ── Orange accent. Deepened to #D9531E in light/white themes for WCAG-AA on white. ── -->
    <color name="home_token_accent_orange_light">#D9531E</color>
    <color name="home_token_accent_orange_faint_light">#59D9531E</color>
    <color name="home_token_accent_orange_light_light">#C24416</color>
    <color name="home_token_accent_orange_dark_light">#A8330F</color>

    <color name="home_token_accent_orange_white">#D9531E</color>
    <color name="home_token_accent_orange_faint_white">#59D9531E</color>
    <color name="home_token_accent_orange_light_white">#C24416</color>
    <color name="home_token_accent_orange_dark_white">#A8330F</color>

    <!-- Orange kept vivid in dark/black — pops on dark backgrounds. -->
    <color name="home_token_accent_orange_dark">#FF6B35</color>
    <color name="home_token_accent_orange_faint_dark">#59FF6B35</color>
    <color name="home_token_accent_orange_light_dark">#FF8C5B</color>
    <color name="home_token_accent_orange_dark_dark">#BF3A1E</color>

    <color name="home_token_accent_orange_black">#FF6B35</color>
    <color name="home_token_accent_orange_faint_black">#59FF6B35</color>
    <color name="home_token_accent_orange_light_black">#FF8C5B</color>
    <color name="home_token_accent_orange_dark_black">#BF3A1E</color>

    <!-- ── Purple accent. ── -->
    <color name="home_token_accent_purple_light">#6F4BE6</color>
    <color name="home_token_accent_purple_white">#6F4BE6</color>
    <color name="home_token_accent_purple_dark">#A78BFA</color>
    <color name="home_token_accent_purple_black">#A78BFA</color>

    <!-- ── Tile surface + strokes. ── -->
    <color name="home_token_tile_surface_light">#F3F3F6</color>
