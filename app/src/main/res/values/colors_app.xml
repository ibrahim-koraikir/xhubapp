    <color name="home_token_tile_stroke_dark">#1AFFFFFF</color>
    <color name="home_token_tile_stroke_black">#1AFFFFFF</color>

    <!-- ── Foreground / icon / label tones. ── -->
    <color name="home_token_muted_fg_light">#5C5C66</color>
    <color name="home_token_muted_fg_white">#5C5C66</color>
    <color name="home_token_muted_fg_dark">#FF888888</color>
