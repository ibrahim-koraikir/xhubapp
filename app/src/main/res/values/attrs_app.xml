<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ── Home-screen semantic color tokens ─────────────────────────────── -->
    <!-- Each is assigned a concrete per-theme value in styles.xml
         (Theme.App.Light/White/Dark/Black). Layouts & drawables reference
         them as ?attr/appColor* so the home screen is theme-adaptive. -->

    <attr name="appColorAccentOrange" format="reference|color" />
    <!-- 35%-alpha orange for decorative quote mark (large 60sp text, non-body) -->
    <attr name="appColorAccentOrangeFaint" format="reference|color" />
    <attr name="appColorAccentOrangeLight" format="reference|color" />
    <attr name="appColorAccentOrangeDark" format="reference|color" />
    <attr name="appColorAccentPurple" format="reference|color" />

    <attr name="appColorHomeTileSurface" format="reference|color" />
    <attr name="appColorHomeStroke" format="reference|color" />
    <attr name="appColorHomeTileStroke" format="reference|color" />

    <attr name="appColorMutedForeground" format="reference|color" />
    <attr name="appColorSubtleForeground" format="reference|color" />
    <attr name="appColorDimForeground" format="reference|color" />
    <attr name="appColorIconTint" format="reference|color" />
    <attr name="appColorGroupLabel" format="reference|color" />

    <!-- Starfield scrim color (the overlay View on top of the background image) -->
    <attr name="appStarfieldScrim" format="reference|color" />

    <!-- Glassmorphism overlays: translucent fills/strokes for pills, chips, glass buttons.
         White-alpha on dark themes, black-alpha on light themes (inverts for visibility). -->
    <attr name="appColorGlassFill" format="reference|color" />
    <attr name="appColorGlassStroke" format="reference|color" />

    <!-- The home background drawable itself (reference, NOT color) -->
    <attr name="appHomeBackground" format="reference" />

</resources>
