# Keystore configuration for release signing
# Copy this file to 'keystore.properties' and fill in your actual values
# NEVER commit keystore.properties or your .jks/.keystore file to version control!

# Path to your keystore file (relative to project root or absolute path)
storeFile=path/to/your/release.keystore

# Keystore password
storePassword=your_keystore_password

# Key alias (the name of the key entry in the keystore)
keyAlias=your_key_alias

# Key password (may be the same as keystore password)
keyPassword=your_key_password
